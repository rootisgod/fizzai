<% @page_title = "Factory Skills" %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= back_link_to "Factory", factory_root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
  </div>

  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
<% end %>

<section class="panel panel--wide shadow center txt-align-start flex flex-column gap">
  <% if @skills.any? %>
    <ul class="unpad margin-none flex flex-column gap">
      <% @skills.each do |skill| %>
        <li>
          <strong><%= link_to skill.name, factory_skill_path(skill) %></strong>
          <% unless skill.active? %>
            <span class="txt-small txt-subtle">Inactive</span>
          <% end %>
          <% if skill.description.present? %>
            <p class="margin-none txt-small txt-subtle"><%= skill.description %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="margin-none">No skills yet.</p>
  <% end %>

  <%= link_to new_factory_skill_path, class: "btn btn--link" do %>
    <%= icon_tag "add" %>
    <span>New skill</span>
  <% end %>
</section>
